# Agent V3 — wyłącznie prototyp. Nie kopiuj tu sekretów ani sesji V2.
AGENT_V3_MODE=fixture
AGENT_V3_KILL_SWITCH=1
AGENT_V3_DRY_RUN=1

# Klucze testowe modeli. W fixture pozostają puste.
AGENT_V3_ANTHROPIC_API_KEY=
AGENT_V3_DEEPSEEK_API_KEY=
AGENT_V3_OPENAI_API_KEY=

# Odseparowane konto testowe; produkcyjny handle jest bezwarunkowo zabroniony.
AGENT_V3_TEST_ACCOUNT_HANDLE=
AGENT_V3_SUBSTACK_HANDLE=

# Wymagane tylko do mutacji w live_test.
AGENT_V3_LIVE_TEST_CONFIRM=

# Opcjonalny tryb uruchomienia przeglądarki V3.
AGENT_V3_SERVER=0
AGENT_V3_NO_LIMIT=0

# Alarm testowy V3; niedostępny poza live_test.
AGENT_V3_ALARM_EMAIL_TO=
AGENT_V3_SMTP_HOST=smtp.gmail.com
AGENT_V3_SMTP_PORT=587
AGENT_V3_SMTP_USER=
AGENT_V3_SMTP_PASSWORD=
