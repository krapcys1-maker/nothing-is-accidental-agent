[Unit]
Description=Nothing Is Accidental — artykul tygodniowy
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/nothing-is-accidental-agent
Environment=AGENT_V2_SERVER=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/nothing-is-accidental-agent/.venv/bin/python agent-v2/run.py --wyslij
MemoryMax=3G
TimeoutStartSec=5400
