[Unit]
Description=Zegar agenta NIA

[Timer]
# TRZY uruchomienia dziennie, nie jedno. Wlasciciel zauwazyl, ze dwie notki
# wyszly trzy minuty po sobie: caly dzienny przydzial szedl w jednym ciagu.
# Kazdy przebieg dobiera tylko brakujaca czesc, wiec notki rozkladaja sie na
# godziny.
#
# Godziny sluza CZYTELNIKOM, nie serwerowi: 11:20, 15:00 i 20:10 UTC to 7:20,
# 11:00 i 16:10 rano i po poludniu w Nowym Jorku. Poprzednie 16:40 UTC wypadalo
# 12:40 u czytelnikow, czyli w NAJGORSZYM oknie wg researchu.
#
# Wszystkie sa tez POZA szczytem taryfowym DeepSeeka (01-04 i 06-10 UTC),
# wiec jedna decyzja zalatwia dwie rzeczy: wyglada po ludzku i kosztuje polowe.
OnCalendar=*-*-* 11:20:00
OnCalendar=*-*-* 15:00:00
OnCalendar=*-*-* 20:10:00
Persistent=true

# Losowe opoznienie do 25 minut: agent odpalajacy sie co do sekundy o rownej
# godzinie kazdego dnia jest rozpoznawalny jako maszyna nawet bez patrzenia
# w tresc.
RandomizedDelaySec=1500

[Install]
WantedBy=timers.target
