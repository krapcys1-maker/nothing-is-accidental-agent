# Skopiuj ten plik jako .env i uzupełnij wartości.
# .env jest w .gitignore i NIE trafia do repo. Klucza NIGDY nie wklejaj do
# dokumentów, logów, screenshotów ani do tego pliku przykładowego.

# --- Klucz API (lokalnie) ---
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# --- Modele (pochodzą z env, NIE z kodu) ---
# Przykładowe wartości; dostosuj do modeli, których używasz.
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_QUALITY=claude-sonnet-5

# --- Cennik do szacowania kosztów (USD) ---
# Dostosuj do aktualnego cennika dostawcy. Używane przez UsageTracker.
PRICE_INPUT_USD_PER_MTOK=1.00
PRICE_OUTPUT_USD_PER_MTOK=5.00
PRICE_CACHE_READ_USD_PER_MTOK=0.10
PRICE_CACHE_WRITE_USD_PER_MTOK=1.25
PRICE_WEB_SEARCH_USD_PER_1K=10.00

# --- Tryb pracy ---
# DRY_RUN=true  -> brak realnych wywołań i akcji zewnętrznych (używa klienta zastępczego)
DRY_RUN=true
KILL_SWITCH=false

# --- alarm do wlasciciela (e-mail) ---
# Jedyny kanal, ktorym agent mowi "stalo sie zle". Bez tego dziala normalnie,
# tylko cicho: awaria sesji nie dotrze do nikogo.
# Dla Gmaila SMTP_PASSWORD to HASLO APLIKACJI, nie haslo do konta.
ALARM_EMAIL_TO=twoj@adres.pl
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=twoj@gmail.com
SMTP_PASSWORD=
